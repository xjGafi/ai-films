{
  "name": "ai-films",
  "version": "0.1.0",
  "description": "AI long video generation pipeline: story + character images → 1-2 min film",
  "type": "module",
  "bin": {
    "ai-film": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome check --fix src/",
    "test": "tsx src/tests/smoke.ts",
    "test:api": "tsx src/tests/integration.ts",
    "test:api:quick": "tsx src/tests/integration.ts --quick"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.85.0",
    "sharp": "^0.33.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
